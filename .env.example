# Copy to .env.local. Nothing here is required to build or run the public static site; each block switches one backend feature on.

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://addictionrehabcenters.ca
# true = 301 every *.vercel.app request to the production domain (set after the domain is attached)
REDIRECT_PREVIEW_TO_CANONICAL=false
PRODUCTION_HOSTS=
# Origin used in e-mailed links (defaults to NEXT_PUBLIC_SITE_URL)
APP_ORIGIN=

# --- Analytics (defaults are the old site's IDs) -----------------------------
NEXT_PUBLIC_GA_ID=G-8RYYPCC7ZJ
NEXT_PUBLIC_META_PIXEL_ID=829671655143836
NEXT_PUBLIC_SMARTSUPP_KEY=1b60661a0d7961f780b319f806a6be8744d8e10c
NEXT_PUBLIC_ANALYTICS_HOSTS=addictionrehabcenters.ca,www.addictionrehabcenters.ca

# --- Supabase (database + file storage) --------------------------------------------------------------
# Project URL (Settings > API). Server-side only except where noted.
SUPABASE_URL=
# service_role key (Settings > API). SECRET: server only, never prefix with NEXT_PUBLIC_. Used for photo uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for centre photos (created by the setup steps in audit/23-supabase-setup.md)
SUPABASE_STORAGE_BUCKET=centre-photos
# Runtime Postgres connection: the POOLED "Transaction pooler" string (port 6543), Settings > Database > Connection string
DATABASE_URL=
# Migrations: the DIRECT connection (port 5432) or "Session pooler" string; used only by `npm run db:migrate`
DIRECT_URL=
# First master admin, created or promoted by `npm run db:migrate`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local development only: embedded Postgres in this folder (no Supabase needed), optional seeded admin, dev e-mail outbox
ARC_LOCAL_DB=
ARC_SEED_ADMIN_EMAIL=
ARC_SEED_ADMIN_PASSWORD=
ENABLE_DEV_OUTBOX=

# --- Auth ----------------------------------------------------------------------
# Long random string; used to hash IP addresses stored with leads
AUTH_SECRET=

# --- E-mail (Resend) ------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Addiction Rehab Centres Canada <no-reply@addictionrehabcenters.ca>
# Where new claims / leads / submissions are announced
ADMIN_NOTIFY_EMAIL=

# --- Spam protection (Cloudflare Turnstile; optional) --------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Photo uploads: optional fallback if Supabase Storage is not configured (Vercel Blob) ---------------
BLOB_READ_WRITE_TOKEN=

# --- Payments (Stripe; plans stay "Coming soon" until these exist) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VERIFIED=
STRIPE_PRICE_LOCAL=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_NATIONAL=

# --- Reviews (real Google data only) ------------------------------------------------
GOOGLE_PLACES_API_KEY=

# --- Demo data (design comparison only; never in production) -------------------------
SHOW_SAMPLE_DATA=false
ENABLE_DESIGN_ROUTES=
